@model IEnumerable<CourseResponse>
@{
    int numberOfTrainees = ViewData["CountOfTrainees"] is int count ? count : 0;
}

<div class="container mt-4">
    <h2 class="mb-4">My Courses</h2>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a class="btn btn-primary" asp-action="AddCourse">+ Add New Course</a>

        <span class="alert alert-success disabled mb-0">
            Total Trainees: <strong>@numberOfTrainees</strong>
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You haven't created any courses yet.</div>
    }
    else
    {
        <div class="container mt-4">
            <div class="row g-4">
                @foreach (var course in Model)
                {
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100">
                            <img src="~/images/courses/DSCourse.jpg" class="card-img-top" alt="Course Image">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@course.Title</h5>
                                <p class="card-text">@course.Description</p>
                                <a href="#" class="btn btn-sm btn-info mt-auto">Course Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    }
</div>
