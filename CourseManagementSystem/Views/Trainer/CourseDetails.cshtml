@model CourseDetails

@{
    ViewData["Title"] = "Course Details";
}

<div class="container mt-5">
    <div class="row">
        <!-- Course Image -->
        <div class="col-md-5">
            <img src="~/Files/images/courses/@Model.ImageName" class="img-fluid rounded shadow" alt="Course Image" />
        </div>

        <!-- Course Info -->
        <div class="col-md-7">
            <h2>@Model.Title</h2>
            <p class="text-muted">@Model.Description</p>

            <ul class="list-group list-group-flush my-3">
                <li class="list-group-item">
                    <strong>Price:</strong> $@Model.Price
                </li>
                <li class="list-group-item">
                    <strong>Duration:</strong> @Model.Hours hours
                </li>
                <li class="list-group-item">
                    <strong>Topics Covered:</strong>
                    @* Uncomment if Topics exist
                    <ul class="mt-2">
                        @foreach (var topic in Model.Topics)
                        {
                            <li>@topic</li>
                        }
                    </ul>
                    *@
                </li>
            </ul>

            <!-- Action Buttons -->
            <div class="mt-4 d-flex gap-2 flex-wrap">
                <a asp-action="Lessons" asp-route-id="@Model.Id" class="btn btn-primary">Go to Lessons</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <form asp-action="Update" method="post" asp-route-id="@Model.Id" class="d-inline">
                    <button type="submit" class="btn btn-success">Update</button>
                </form>
                <!-- Trigger Delete Modal -->
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@Model.Id">
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal-@Model.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@Model.Id" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="deleteModalLabel-@Model.Id">Delete Course</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this course?
            </div>
            <div class="modal-footer">
                <form asp-action="DeleteCourse" asp-controller="Trainer" asp-route-id="@Model.Id" method="post">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <input type="submit" value="Delete" class="btn btn-danger" />
                </form>
            </div>
        </div>
    </div>
</div>
