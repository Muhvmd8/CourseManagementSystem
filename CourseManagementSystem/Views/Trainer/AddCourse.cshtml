@using CMS.PL.Models.Course
@model AddEditCourseViewModel

@{
    ViewData["Title"] = "Add New Course";
}

<div class="container mt-5">
    <h2 class="mb-4">Add New Course</h2>

    <form asp-action="AddCourse" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>

        <partial name="PartialViews/_AddEditCoursePartialView" />
        <!-- Hidden TrainerId -->
        @* <input asp-for="TrainerId" type="hidden" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" /> *@

        <button type="submit" class="btn btn-success">Add Course</button>
    </form>
</div>

@section validation {
    <partial name="_ValidationScriptsPartial">
}

