@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="top-nav">
    Already have an account? <a asp-controller="Account" asp-action="Login">Sign In</a>
</div>

<div class="auth-form">
    <h1>Welcome to CMS!</h1>
    <p>Register your account</p>

    <form asp-action="Register" method="post">

        <input asp-for="FullName" placeholder="Name" required="">
        <span asp-validation-for="FullName"></span>
        <br />
        <br />
        <input asp-for="UserName" placeholder="UserName" required="">
        <span asp-validation-for="UserName"></span>
        <br />
        <br />
        <input asp-for="Email" placeholder="Email" required="">
        <span asp-validation-for="Email"></span>
        <br />
        <br />
        <input asp-for="Password" placeholder="Password" required="">
        <span asp-validation-for="Password"></span>
        <br />
        <br />
        <input asp-for="ConfirmPassword" placeholder="Confirm Password" required="">
        <span asp-validation-for="ConfirmPassword"></span>
        <br />
        <br />

        <div style="margin-top: 1rem;">
            <label>
                <input type="checkbox" asp-for="IsAgree" />
                <span>Is Agree</span>
            </label>
            <span asp-validation-for="IsAgree" style="color:red;"></span>
        </div>


        <button class="btn-primary">Login</button>
    </form>

    <div class="social-icons">
        <img src="/images/facebook.png" alt="Facebook" />
        <img src="/images/linkedin.png" alt="LinkedIn" />
        <img src="/images/google.png" alt="Google" />
    </div>
</div>

@section Validation {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}