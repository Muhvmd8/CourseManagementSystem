@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}


<div class="auth-form">
    <h1>Find Your Account</h1>
    <p>Please enter your email address or mobile number to search for your account.</p>
    <br />
    <br />
    <form asp-action="SendResetPasswordUrl" method="post">

        <input asp-for="Email" placeholder="Email address or mobile number" required="">
        <span asp-validation-for="Email"></span>
        <br />


        <button class="btn-primary">Search</button>
        <a class="btn-close-white" asp-action="Login">Cancel</a>
    </form>
</div>

@section Validation {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}