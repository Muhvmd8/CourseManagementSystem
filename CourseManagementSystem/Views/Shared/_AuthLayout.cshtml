<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Focus</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
        }

        .auth-container {
            display: flex;
            min-height: 100vh;
        }

        .auth-left {
            background: linear-gradient(to bottom right, #7f5af0, #6246ea);
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            padding: 2rem;
        }

        .auth-right {
            flex: 1;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .auth-form {
            max-width: 400px;
            margin: 0 auto;
        }

        .auth-form h1 {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .auth-form label {
            display: block;
            margin: 1rem 0 0.5rem;
        }

        .auth-form input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        .btn-primary {
            margin-top: 2rem;
            width: 100%;
            padding: 0.75rem;
            border: none;
            border-radius: 6px;
            background: #7f5af0;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            margin-top: 1.5rem;
            gap: 1rem;
        }

        .social-icons img {
            width: 32px;
            cursor: pointer;
        }

        .top-nav {
            text-align: right;
            margin-bottom: 1rem;
        }

        .top-nav a {
            color: #6246ea;
            text-decoration: none;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-left">
            <img src="~/images/auth-illustration.png" alt="Illustration" style="width: 80%;">
        </div>
        <div class="auth-right">
            @RenderBody()
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* @await RenderSectionAsync("Scripts", required: false) *@
    @RenderSection("validation", required: false)
</body>
</html>

